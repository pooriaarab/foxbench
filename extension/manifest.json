{
  "manifest_version": 3,
  "name": "foxbench demo",
  "version": "0.1.1",
  "description": "Try the foxbench tasks by hand: pick a task, and the mock site opens with its goal.",
  "browser_specific_settings": {
    "gecko": {
      "id": "foxbench@pooriaarab",
      "strict_min_version": "153.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "permissions": [
    "storage"
  ],
  "action": {
    "default_title": "foxbench demo",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "http://127.0.0.1/*",
        "http://localhost/*"
      ],
      "js": [
        "content.js"
      ]
    }
  ]
}
